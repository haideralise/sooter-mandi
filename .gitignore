# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.env.local

# Backend (Laravel)
backend/vendor/
# Catch every real env file. Laravel auto-loads `.env.<APP_ENV>`, so a stray
# .env.local silently overrides .env -- keep all variants out of git.
backend/.env
backend/.env.*
!backend/.env.example
backend/storage/logs/*
backend/storage/app/public/*
backend/bootstrap/cache/*
backend/node_modules/
backend/public/hot
backend/public/storage
backend/*.log
backend/.phpunit.result.cache

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.*.local

frontend/dist/
frontend/build/
frontend/.vercel
frontend/*.tsbuildinfo

# Database
*.sql
*.sqlite
*.db

# OS
Thumbs.db
.DS_Store

